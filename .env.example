# ─── Core / auth ─────────────────────────────────────────────
NODE_ENV=development
JWT_SECRET=
SESSION_SECRET=
# Mot de passe back-office admin (ou hash bcrypt via ADMIN_PASSWORD_HASH)
ADMIN_PASSWORD=
ADMIN_PASSWORD_HASH=
# Secret pour routes admin (ex. /api/admin/app-version)
ADMIN_SECRET=

# ─── OneSignal (push) ────────────────────────────────────────
ONESIGNAL_CLIENT_APP_ID=
ONESIGNAL_DRIVER_APP_ID=
ONESIGNAL_REST_API_KEY_CLIENT=
ONESIGNAL_REST_API_KEY_DRIVER=
# Optionnel — icône notifications
RAVE_LOGO_URL=

# ─── Cloudinary (médias) ─────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Yousign (signature électronique) ────────────────────────
YOUSIGN_API_KEY=
# true = sandbox (api-sandbox.yousign.app) | false = production
YOUSIGN_SANDBOX=true

# ─── PayZen / OSB (loueurs) — optionnel ──────────────────────
OSB_CREDENTIALS_ENCRYPTION_KEY=
OSB_AWS_KMS_KEY_ID=

# ─── Autres (optionnel) ──────────────────────────────────────
DATABASE_URL=
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
GOOGLE_MAPS_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
